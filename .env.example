# Public, non-secret canonical origin. Do not add a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string. Required when database features are enabled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Optional direct CLI/migration connection when the runtime URL uses a pooler.
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?schema=public

# Resend. Required only when appointment email delivery is enabled.
RESEND_API_KEY=re_replace_me
APPOINTMENT_NOTIFICATION_TO=clinic@example.com
EMAIL_FROM=Psychology Clinic <appointments@example.com>

# Appointment lifecycle. Legal approval is required before production.
APPOINTMENT_RETENTION_DAYS=90

# Trust proxy IP headers only on a known hosting/tunnel infrastructure.
TRUST_PROXY_HEADERS=false

# Authentication secret. Generate a long random value; never commit the real value.
AUTH_SECRET=replace_with_at_least_32_random_characters

# Admin sessions have an absolute lifetime; 1-24 hours.
ADMIN_SESSION_HOURS=8
