{
  "name": "psychology-clinic-hasan-durusoy",
  "version": "0.1.0",
  "private": true,
  "description": "Hasan Durusoy psikoloji kliniği web sitesi",
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <27",
    "npm": ">=10.9.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "npm run build && tsx scripts/run-playwright.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run prisma:validate && npm run prisma:generate && npm run typecheck && npm run test && npm run build",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts",
    "admin:revoke-sessions": "tsx scripts/revoke-admin-sessions.ts",
    "appointments:purge-expired": "tsx scripts/purge-expired-appointments.ts",
    "appointments:audit-privacy": "tsx scripts/audit-appointment-privacy.ts",
    "privacy:cleanup-expired": "tsx scripts/cleanup-expired-operational-data.ts",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "audit": "npm audit --omit=dev --audit-level=high",
    "security:secrets": "tsx scripts/scan-secrets.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.44.0",
    "dotenv": "^17.2.3",
    "next": "16.3.0",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.1",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.9.0",
    "eslint-config-next": "16.3.2",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "nanoid": "3.3.18"
  }
}
