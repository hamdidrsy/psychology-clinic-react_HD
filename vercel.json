{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run production:check && npm run build",
  "crons": [
    {
      "path": "/api/cron/appointment-notifications",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/privacy-cleanup",
      "schedule": "15 3 * * *"
    }
  ]
}
